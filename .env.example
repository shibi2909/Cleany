# ─────────────────────────────────────────────────────────────
# Cleany environment variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` — it is git-ignored.
# ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by server actions for validated writes. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Maps. Provider: "leaflet" (OpenStreetMap, no key needed) or "google".
NEXT_PUBLIC_MAPS_PROVIDER=leaflet
# Required only when NEXT_PUBLIC_MAPS_PROVIDER=google (Maps JavaScript API + Geocoding API enabled).
NEXT_PUBLIC_MAPS_API_KEY=
# Optional server-side key for Google geocoding (restrict it to the Geocoding API). Falls back to the public key.
GOOGLE_MAPS_SERVER_KEY=

# WhatsApp number in international format, digits only (e.g. 919876543210).
# Admin Settings → WhatsApp can override this at runtime.
NEXT_PUBLIC_BUSINESS_WHATSAPP_NUMBER=

# Public site URL (used for auth email redirects, Open Graph and sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
